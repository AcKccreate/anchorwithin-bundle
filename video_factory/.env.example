# ============================================================
# Video Factory — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Telegram Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- YouTube OAuth ---
# Path to your Google OAuth client_secret.json file
YOUTUBE_CLIENT_SECRETS=
# Path where the OAuth token will be saved after first auth
YOUTUBE_TOKEN_PATH=

# --- Paths (optional — defaults to Windows standard paths) ---
# VIDEO_FACTORY_BASE=C:\Users\acase\AnchorWithin\video_factory
# READY_TO_UPLOAD_DIR=C:\Users\acase\AnchorWithin\videos\ready_to_upload

# --- FFmpeg (optional — defaults to 'ffmpeg' on PATH) ---
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BIN=C:\ffmpeg\bin\ffprobe.exe
