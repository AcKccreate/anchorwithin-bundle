# AnchorWithin Marketing Automation — Environment Variables
# Copy to .env and fill in your values (or set as system environment variables)

# Telegram notifications (used by all three scripts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twitter/X API (used by auto_poster)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Reddit API (used by auto_poster)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Stripe (used by morning_revenue_check)
STRIPE_SECRET_KEY=

# IndexNow (used by directory_submitter for Bing/Yandex)
INDEXNOW_KEY=
